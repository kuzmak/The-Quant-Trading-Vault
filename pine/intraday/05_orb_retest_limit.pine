// Port of strategies/Multi-Timeframe-Opening-Range-Breakout-Strategy-with-Limit-Entry-and-Automated-Risk-Management.md
// to Pine Script v6 for CME equity index futures (NQ / ES, 1-5 minute bars).
//
// Rules: build the 09:30-09:35 ET opening range. The first bar that trades entirely outside the range sets the
// direction. Enter on a pullback with a limit order at the range edge; stop at the opposite edge; target at
// R x risk; flatten before the close.
//
// Fixes vs. the original:
//  - The range is the true high/low of every bar in the window. The original kept only the first bar's values
//    (`openingHigh := na(openingHigh) ? high : openingHigh`).
//  - Unfilled limit orders are cancelled at the entry cutoff and never carry into the next session.
//  - The end-of-day exit fires on the first bar closing at/after the flatten time. The original required
//    `time_close` to equal 15:55 exactly, which never happens on many timeframes.
//  - Day boundaries and session times are New York time (the original mixed the exchange-timezone calendar
//    date with New York timestamps).
//  - The quirk that replaced the target with the breakout bar's extreme is removed.
//  - A "Market on confirmation" entry mode is added to measure the adverse selection of retest-only limit fills.
//  - Contract sizing (the original used 100% of equity), per-contract commission and slippage.

//@version=6
strategy(
     "ORB Retest (limit entry) [CME index futures]",
     shorttitle              = "ORB Retest",
     overlay                 = true,
     initial_capital         = 50000,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     commission_type         = strategy.commission.cash_per_contract,
     commission_value        = 2.5,
     slippage                = 1,
     // Futures margin is not modelled by the broker emulator; v6 defaults (100%) would trigger false margin calls.
     margin_long             = 0,
     margin_short            = 0,
     process_orders_on_close = false,
     calc_on_every_tick      = false)

// ————— Constants
const string TZ           = "America/New_York"
const int    MS_IN_MIN    = 60 * 1000
const string SIZE_FIXED   = "Fixed contracts"
const string SIZE_RISK    = "Risk per trade ($)"
const string ENTRY_RETEST = "Retest limit at range edge"
const string ENTRY_MARKET = "Market on confirmation"
const string ID_LONG      = "ORBR L"
const string ID_SHORT     = "ORBR S"
const string ID_LONG_X    = "ORBR L exit"
const string ID_SHORT_X   = "ORBR S exit"

const string GRP_SESSION  = "Session (New York time)"
const string GRP_SIGNAL   = "Entries & exits"
const string GRP_SIZE     = "Position sizing"
const string GRP_VISUAL   = "Visuals"

const string TT_ENTRY  = "Retest = original rule: after a bar closes fully outside the range, rest a limit order at the broken edge. Market = enter at the next bar's open instead (stop and target still referenced to the range), useful to compare fill quality."
const string TT_TARGET = "Take-profit as a multiple of the initial risk (range edge to opposite edge)."
const string TT_RISK   = "Risk mode: contracts = floor(risk $ / (range height x point value)), capped by Max contracts. A day is skipped if not even one contract fits the budget."

// ————— Inputs
int    orStartHourInput    = input.int(9,  "Range start",        minval = 0, maxval = 23, inline = "or",   group = GRP_SESSION)
int    orStartMinuteInput  = input.int(30, ":",                  minval = 0, maxval = 59, inline = "or",   group = GRP_SESSION)
int    orMinutesInput      = input.int(5, "Range length (min)", minval = 1, maxval = 240,                  group = GRP_SESSION)
int    entryEndHourInput   = input.int(12, "Entry cutoff",       minval = 0, maxval = 23, inline = "ee",   group = GRP_SESSION)
int    entryEndMinuteInput = input.int(0,  ":",                  minval = 0, maxval = 59, inline = "ee",   group = GRP_SESSION)
int    flatHourInput       = input.int(15, "Flatten at",         minval = 0, maxval = 23, inline = "flat", group = GRP_SESSION)
int    flatMinuteInput     = input.int(55, ":",                  minval = 0, maxval = 59, inline = "flat", group = GRP_SESSION)

bool   longsInput          = input.bool(true, "Longs",  inline = "dir", group = GRP_SIGNAL)
bool   shortsInput         = input.bool(true, "Shorts", inline = "dir", group = GRP_SIGNAL)
string entryModeInput      = input.string(ENTRY_RETEST, "Entry", options = [ENTRY_RETEST, ENTRY_MARKET], tooltip = TT_ENTRY, group = GRP_SIGNAL)
float  targetRInput        = input.float(2.0, "Target (R multiple)", minval = 0.25, step = 0.25, tooltip = TT_TARGET, group = GRP_SIGNAL)

string sizingModeInput     = input.string(SIZE_FIXED, "Sizing", options = [SIZE_FIXED, SIZE_RISK], tooltip = TT_RISK, group = GRP_SIZE)
int    fixedQtyInput       = input.int(1, "Fixed contracts", minval = 1, group = GRP_SIZE)
float  riskUsdInput        = input.float(500.0, "Risk per trade ($)", minval = 1.0, group = GRP_SIZE)
int    maxQtyInput         = input.int(10, "Max contracts", minval = 1, group = GRP_SIZE)

bool   showLevelsInput     = input.bool(true, "Show range and trade levels", group = GRP_VISUAL)

// ————— Functions
//@function Returns the UNIX time of `hh:mm` New York time on the current bar's New York calendar date.
//@param hh (simple int) Hour, 0-23.
//@param mm (simple int) Minute, 0-59.
//@returns (int) Timestamp in milliseconds.
todayAt(simple int hh, simple int mm) =>
    timestamp(TZ, year(time, TZ), month(time, TZ), dayofmonth(time, TZ), hh, mm, 0)

//@function Contracts to trade when the stop is `stopDistance` price units away from the entry.
//@param stopDistance (float) Entry-to-stop distance in price units.
//@returns (float) Whole contracts, capped by `maxQtyInput`; 0 when the risk budget cannot afford one contract.
//Dependencies: sizingModeInput, fixedQtyInput, riskUsdInput, maxQtyInput.
contractsFor(float stopDistance) =>
    float qty = switch sizingModeInput
        SIZE_FIXED => float(fixedQtyInput)
        =>            stopDistance > 0 ? math.floor(riskUsdInput / (stopDistance * syminfo.pointvalue)) : 0.0
    math.min(qty, maxQtyInput)

// ————— Guards
if barstate.isfirst
    if not timeframe.isintraday
        runtime.error("Use an intraday chart (1-5 minute bars recommended).")
    if timeframe.in_seconds() > orMinutesInput * 60
        runtime.error("The chart timeframe must not be longer than the opening-range length.")

// ————— Session clock
int  orStartTs    = todayAt(orStartHourInput, orStartMinuteInput)
int  orEndTs      = orStartTs + orMinutesInput * MS_IN_MIN
int  entryEndTs   = todayAt(entryEndHourInput, entryEndMinuteInput)
int  flatTs       = todayAt(flatHourInput, flatMinuteInput)
int  barMs        = timeframe.in_seconds() * 1000
// True from the last bar that ends at/before the flatten time: the next bar would end after it.
bool flattenNow   = time_close + barMs > flatTs
bool isOrBar      = time >= orStartTs and time < orEndTs
bool isOrFirstBar = isOrBar and (na(time[1]) or time[1] < orStartTs)
bool isOrLastBar  = isOrBar and time_close >= orEndTs
// Breakout bars must start after the range is complete; orders sent on their close work from the next bar.
bool inEntryTime  = time >= orEndTs and time_close < entryEndTs and not flattenNow

// ————— Opening range and direction state
var float orHigh     = na
var float orLow      = na
var int   rangeDayTs = na     // `orStartTs` of the day whose range is complete
var int   direction  = 0      // +1 long setup, -1 short setup, 0 none yet today
var bool  tradedDay  = false

if isOrFirstBar
    orHigh    := high
    orLow     := low
    direction := 0
    tradedDay := false
else if isOrBar and not na(orHigh)
    orHigh := math.max(orHigh, high)
    orLow  := math.min(orLow, low)

if isOrLastBar and not na(orHigh)
    rangeDayTs := orStartTs

bool  rangeReady = not na(rangeDayTs) and rangeDayTs == orStartTs
float orHeight   = orHigh - orLow

int tradeCount = strategy.closedtrades + strategy.opentrades
if tradeCount > nz(tradeCount[1])
    tradedDay := true

// The first bar entirely outside the range sets the day's direction (only once per day).
bool newDirection = rangeReady and inEntryTime and direction == 0 and orHeight > 0 and (low > orHigh or high < orLow)
if newDirection
    direction := low > orHigh ? 1 : -1

// ————— Trade levels (fixed for the day once the range is known)
float longEntry   = orHigh
float longStop    = orLow
float longTarget  = math.round_to_mintick(orHigh + targetRInput * orHeight)
float shortEntry  = orLow
float shortStop   = orHigh
float shortTarget = math.round_to_mintick(orLow - targetRInput * orHeight)
float qty         = contractsFor(orHeight)

bool setupLive = rangeReady and inEntryTime and not tradedDay and strategy.position_size == 0 and qty >= 1
bool armLong   = setupLive and direction == 1 and longsInput
bool armShort  = setupLive and direction == -1 and shortsInput

// ————— Orders
if entryModeInput == ENTRY_RETEST
    // Resting limit at the broken edge, re-sent each bar until filled or the cutoff passes.
    if armLong
        strategy.entry(ID_LONG, strategy.long, qty = qty, limit = longEntry,
             alert_message = "ORB retest long limit " + str.tostring(longEntry))
        strategy.exit(ID_LONG_X, ID_LONG, stop = longStop, limit = longTarget, comment_loss = "SL",
             comment_profit = "TP")
    else if armShort
        strategy.entry(ID_SHORT, strategy.short, qty = qty, limit = shortEntry,
             alert_message = "ORB retest short limit " + str.tostring(shortEntry))
        strategy.exit(ID_SHORT_X, ID_SHORT, stop = shortStop, limit = shortTarget, comment_loss = "SL",
             comment_profit = "TP")
else
    // Market at the next open, only on the confirmation bar itself.
    if armLong and newDirection
        strategy.entry(ID_LONG, strategy.long, qty = qty, alert_message = "ORB confirmation long")
        strategy.exit(ID_LONG_X, ID_LONG, stop = longStop, limit = longTarget, comment_loss = "SL",
             comment_profit = "TP")
    else if armShort and newDirection
        strategy.entry(ID_SHORT, strategy.short, qty = qty, alert_message = "ORB confirmation short")
        strategy.exit(ID_SHORT_X, ID_SHORT, stop = shortStop, limit = shortTarget, comment_loss = "SL",
             comment_profit = "TP")

// Cancel any resting entry once the setup is no longer live (cutoff passed, already traded, or flat time).
if not armLong and strategy.position_size == 0
    strategy.cancel(ID_LONG)
if not armShort and strategy.position_size == 0
    strategy.cancel(ID_SHORT)

// In a position: keep the bracket working.
if strategy.position_size > 0
    strategy.exit(ID_LONG_X, ID_LONG, stop = longStop, limit = longTarget, comment_loss = "SL", comment_profit = "TP")
else if strategy.position_size < 0
    strategy.exit(ID_SHORT_X, ID_SHORT, stop = shortStop, limit = shortTarget, comment_loss = "SL",
         comment_profit = "TP")

// End-of-day flatten: on the last bar that ends at/before the flatten time, cancel working orders and exit at
// the next bar's open, so the position is flat by the flatten time on any bar size.
if flattenNow
    strategy.cancel_all()
    if strategy.position_size != 0
        strategy.close_all(comment = "EOD", alert_message = "ORB retest end-of-day flatten")

// ————— Visuals
bool  showRange = showLevelsInput and (isOrBar or rangeReady) and time < flatTs
bool  isLong    = strategy.position_size > 0
bool  isShort   = strategy.position_size < 0
float stopPlot  = showLevelsInput ? (isLong ? longStop : isShort ? shortStop : na) : na
float tgtPlot   = showLevelsInput ? (isLong ? longTarget : isShort ? shortTarget : na) : na

plot(showRange ? orHigh : na, "Range high", color.new(color.teal, 0), 2, plot.style_linebr)
plot(showRange ? orLow : na,  "Range low",  color.new(color.maroon, 0), 2, plot.style_linebr)
plot(stopPlot, "Stop",   color.new(color.red, 0),   1, plot.style_linebr)
plot(tgtPlot,  "Target", color.new(color.green, 0), 1, plot.style_linebr)
plotshape(showLevelsInput and newDirection and direction == 1,  "Breakout up",   shape.triangleup,   location.belowbar, color.new(color.teal, 0),   size = size.tiny)
plotshape(showLevelsInput and newDirection and direction == -1, "Breakout down", shape.triangledown, location.abovebar, color.new(color.maroon, 0), size = size.tiny)
bgcolor(showLevelsInput and isOrBar ? color.new(color.gray, 85) : na, title = "Opening range window")
